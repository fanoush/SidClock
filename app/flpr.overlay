/*
 * flpr.overlay - FLPR (VPR RISC-V) resources for the bare-metal engine.
 *
 * Deliberately not the nordic-flpr snippet: the blob is embedded in the
 * M33 image as flpr_blob[] (position-independent, XIP wherever the
 * linker put it), so there is no fixed flash partition and nothing to
 * launch at boot (NORDIC_VPR_LAUNCHER=n). Only the FLPR-side SRAM is
 * reserved here - the M33 never links any of it:
 *
 *   SRAM  0x2002F000-0x2003BFFF (52 KB) hot engine code (cRSID_emulateC64)
 *   SRAM  0x2003C000-0x2003DFFF (8 KB)  PCM ring (FLPR -> M33 audio)
 *   SRAM  0x2003E000-0x2003EFFF (4 KB)  split mode: SID instances, regs, cycles
 *   SRAM  0x2003F000-0x2003FBFF (3 KB)  FLPR private RAM, 1 KB stack on top
 *   SRAM  0x2003FC00-0x2003FFFF (1 KB)  shared control struct
 *
 * Runtime start/stop from the M33 goes through hal/nrf_vpr.h (src/flpr.c).
 * blob_audit.py --check-ram verifies this map against flpr_shared.h.
 */

/ {
	soc {
		reserved-memory {
			#address-cells = <1>;
			#size-cells = <1>;
			flpr_code_ram: memory@2002f000 {
				reg = <0x2002F000 0xD000>;
			};
			flpr_ring_ram: memory@2003c000 {
				reg = <0x2003C000 0x2000>;
			};
			flpr_split_ram: memory@2003e000 {
				reg = <0x2003E000 0x1000>;
			};
			flpr_priv_ram: memory@2003f000 {
				reg = <0x2003F000 0xC00>;
			};
			flpr_shared_ram: memory@2003fc00 {
				reg = <0x2003FC00 0x400>;
			};
		};
	};
};

&cpuapp_vevif_tx {
	status = "okay";
};

/* Keep the UART free for the FLPR side (no UART is wired on this board;
 * logging goes over RTT/BLE either way). */
&uart30 {
	status = "reserved";
};
